{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Cloudflare Pages project that serves the *preview* build. The production
  // project (siki.moe) is deployed separately and is intentionally not the
  // default target here — see README.md § Deployment.
  "name": "siki-moe-preview",
  "compatibility_date": "2026-08-01",
  "pages_build_output_dir": "./dist",
}
