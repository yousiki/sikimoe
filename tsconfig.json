{
  "extends": "astro/tsconfigs/strictest",
  "include": [".astro/types.d.ts", "**/*.ts", "**/*.tsx", "**/*.astro"],
  "exclude": ["dist", "node_modules", ".astro"],
  "compilerOptions": {
    "strictNullChecks": true,
    "allowJs": false,
    "checkJs": false,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "types": ["astro/client", "bun"],
    "baseUrl": ".",
    "paths": {
      "~/*": ["src/*"]
    }
  }
}
