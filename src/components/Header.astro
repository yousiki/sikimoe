---
import { Image } from 'astro:assets';

import CvMenu from './CvMenu.astro';
import Icon from './Icon.astro';
import avatar from '../assets/avatar.jpg';
import { profile } from '../data/profile';

/**
 * `About` is the hero itself — the name, the role and the affiliation are the
 * whole of it, so the link goes to the top of the page rather than to a section
 * of its own. `short` is what the desktop bar shows when the full label would
 * crowd its neighbours; the overlay always sets the full one.
 */
const sections = [
  { id: 'top', label: 'About' },
  { id: 'research', label: 'Research' },
  { id: 'interests', label: 'Interests' },
  { id: 'path', label: 'Path' },
  { id: 'publications', label: 'Publication', short: 'Pub' },
  { id: 'contact', label: 'Contact' },
] as const;

/** The bar shows the abbreviation; the accessible name stays the full word. */
const abbreviated = (section: (typeof sections)[number]): { text: string; label?: string } =>
  'short' in section ? { text: section.short, label: section.label } : { text: section.label };
---

<div
  class="bg-accent fixed inset-x-0 top-0 z-50 h-[2px] origin-left scale-x-0"
  data-scroll-progress
  aria-hidden="true"
>
</div>

<header
  class="fixed inset-x-0 top-0 z-40 transition-[background-color,backdrop-filter,border-color] duration-500 data-scrolled:border-b data-scrolled:backdrop-blur-xl"
  data-header
>
  <nav
    class="container-page flex h-16 items-center justify-between gap-6 md:h-20"
    aria-label="Primary"
  >
    <a
      href="#top"
      class="group flex items-center gap-3"
      aria-label={`${profile.name} — back to top`}
    >
      <span class="avatar">
        <Image
          src={avatar}
          alt=""
          width={80}
          height={80}
          loading="eager"
          decoding="async"
          class="avatar__img"
        />
      </span>
      <span class="hidden font-mono text-xs tracking-widest uppercase sm:inline">siki.moe</span>
    </a>

    <ul class="hidden items-center gap-1 md:flex">
      {
        sections.map((section) => (
          <li>
            <a
              href={`#${section.id}`}
              data-section-link
              aria-label={abbreviated(section).label}
              class="text-muted hover:text-ink relative rounded-full px-3 py-1.5 font-mono text-xs tracking-wider whitespace-nowrap uppercase transition-colors duration-300"
            >
              {abbreviated(section).text}
            </a>
          </li>
        ))
      }
    </ul>

    <div class="flex items-center gap-2">
      <CvMenu id="cv-nav" label="CV" size="sm" align="end" class="hidden sm:block" />

      <button
        type="button"
        data-theme-toggle
        class="border-line hover:border-ink relative grid size-9 place-items-center rounded-full border transition-colors duration-300"
        aria-label="Switch theme"
        aria-pressed="false"
      >
        <Icon name="sun" size={15} class="theme-icon theme-icon--sun" />
        <Icon name="moon" size={15} class="theme-icon theme-icon--moon" />
      </button>

      <button
        type="button"
        data-menu-toggle
        aria-controls="section-index"
        aria-expanded="false"
        class="border-line hover:border-ink grid size-9 place-items-center rounded-full border transition-colors duration-300 md:hidden"
      >
        <span class="sr-only">Open section index</span>
        <span class="burger" aria-hidden="true">
          <span></span>
          <span></span>
        </span>
      </button>
    </div>
  </nav>
</header>

{/* Section index for narrow viewports. */}
<div
  id="section-index"
  data-menu
  hidden
  aria-hidden="true"
  aria-label="Section index"
  class="menu md:hidden"
>
  {
    /* `min-h-full` rather than `h-full`: the index centres itself in the window
      while it fits, and grows past it — scrolling, rather than cropping its ends
      — on a short viewport. */
  }
  <ul class="container-page flex min-h-full flex-col justify-center gap-2 py-6">
    {
      sections.map((section, index) => (
        <li class="menu__item border-line border-b" style={`--menu-index:${index}`}>
          <a
            href={`#${section.id}`}
            class="flex items-baseline gap-5 py-4 transition-colors duration-300"
          >
            <span class="text-faint font-mono text-xs tabular-nums">0{index + 1}</span>
            <span class="font-display text-4xl leading-tight">{section.label}</span>
          </a>
        </li>
      ))
    }
    {
      /* Already inside an overlay, so the three editions are simply listed —
        a nested disclosure would be one more tap for no gain. */
    }
    <li class="menu__item pt-8" style={`--menu-index:${sections.length}`}>
      <span class="eyebrow block">Curriculum Vitae</span>
      <ul class="mt-4 flex flex-wrap gap-2">
        {
          profile.cv.map((edition) => (
            <li>
              <a
                href={edition.href}
                target="_blank"
                rel="noopener"
                class="border-line inline-flex items-center gap-2 rounded-full border px-4 py-2 font-mono text-xs tracking-[0.1em]"
              >
                {edition.label}
                <Icon name="arrow" size={13} />
              </a>
            </li>
          ))
        }
      </ul>
    </li>
  </ul>
</div>

<style>
  header[data-scrolled] {
    background-color: color-mix(in oklab, var(--paper) 72%, transparent);
  }

  /* ── avatar ─────────────────────────────────────────────────────────── */

  .avatar {
    position: relative;
    display: block;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 9999px;
    overflow: hidden;
    /* The ring reads as part of the chrome rather than as a border on the
       photograph, which is why it sits above the image instead of on the box. */
    box-shadow: inset 0 0 0 1px var(--line);
    transition: box-shadow 0.4s var(--ease-out-expo);
  }

  .group:hover .avatar,
  .group:focus-visible .avatar {
    box-shadow: inset 0 0 0 1px color-mix(in oklab, var(--accent) 75%, transparent);
  }

  .avatar__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: saturate(0.85);
    transition:
      filter 0.4s var(--ease-out-expo),
      transform 0.6s var(--ease-out-expo);
  }

  .group:hover .avatar__img {
    filter: none;
    transform: scale(1.08);
  }

  [data-section-link][data-current] {
    color: var(--ink);
  }

  [data-section-link][data-current]::after {
    content: '';
    position: absolute;
    inset-inline: 0.75rem;
    bottom: 0.15rem;
    height: 1px;
    background: var(--accent);
  }

  /* Exactly one glyph is visible, and it shows the theme you get by pressing:
     sun while dark, moon while light. Both are stacked in the same centred
     cell so the swap is a crossfade rather than a reflow. */
  /* Centred by `translate` so the standalone `rotate`/`scale` properties are
     free to animate without the two fighting over `transform`. Rotation is
     about the glyph's own centre, which is what makes the swap read as a turn. */
  .theme-icon {
    position: absolute;
    top: 50%;
    left: 50%;
    translate: -50% -50%;
    transition:
      opacity 0.35s var(--ease-out-expo),
      rotate 0.45s var(--ease-out-expo),
      scale 0.45s var(--ease-out-expo);
  }

  .theme-icon--sun {
    opacity: 1;
    rotate: 0deg;
    scale: 1;
  }

  .theme-icon--moon {
    opacity: 0;
    rotate: 70deg;
    scale: 0.5;
  }

  :global([data-theme='light']) .theme-icon--sun {
    opacity: 0;
    rotate: -70deg;
    scale: 0.5;
  }

  :global([data-theme='light']) .theme-icon--moon {
    opacity: 1;
    rotate: 0deg;
    scale: 1;
  }

  /* ── burger ─────────────────────────────────────────────────────────── */

  .burger {
    display: grid;
    gap: 4px;
    width: 15px;
  }

  .burger span {
    display: block;
    height: 1.5px;
    background: currentcolor;
    transition: transform 0.4s var(--ease-out-expo);
  }

  [data-menu-toggle][aria-expanded='true'] .burger span:first-child {
    transform: translateY(2.75px) rotate(45deg);
  }

  [data-menu-toggle][aria-expanded='true'] .burger span:last-child {
    transform: translateY(-2.75px) rotate(-45deg);
  }

  /* ── overlay ────────────────────────────────────────────────────────── */

  .menu {
    position: fixed;
    inset: 0;
    z-index: 39;
    background-color: var(--paper);
    padding-top: 4rem;
    overflow-y: auto;
    overscroll-behavior: contain;
    opacity: 0;
    transform: translate3d(0, -1.5rem, 0);
    pointer-events: none;
    transition:
      opacity 0.4s var(--ease-out-expo),
      transform 0.4s var(--ease-out-expo);
  }

  .menu[data-open='true'] {
    opacity: 1;
    transform: none;
    pointer-events: auto;
  }

  .menu__item {
    opacity: 0;
    transform: translate3d(0, 1rem, 0);
    transition:
      opacity 0.5s var(--ease-out-expo),
      transform 0.5s var(--ease-out-expo);
    transition-delay: calc(var(--menu-index) * 45ms + 80ms);
  }

  .menu[data-open='true'] .menu__item {
    opacity: 1;
    transform: none;
  }

  .menu__item a:hover,
  .menu__item a:focus-visible {
    color: var(--accent);
  }
</style>
