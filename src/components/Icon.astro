---
/**
 * Hand-picked inline SVGs. A whole icon library would outweigh the eight glyphs
 * this site actually uses.
 */
export type IconName =
  | 'github'
  | 'scholar'
  | 'linkedin'
  | 'mail'
  | 'x'
  | 'arrow'
  | 'arrow-down'
  | 'sun'
  | 'moon'
  | 'copy';

interface Props extends astroHTML.JSX.SVGAttributes {
  name: IconName;
  class?: string | undefined;
  size?: number | undefined;
}

/**
 * `rest` must be spread onto the <svg>. Astro hands a child component the
 * parent's `data-astro-cid-*` as a prop, and that attribute is what makes the
 * parent's scoped styles match — drop it here and every scoped rule aimed at an
 * icon silently matches nothing.
 */
const { name, class: className, size = 16, ...rest } = Astro.props;

const paths: Record<IconName, string> = {
  github:
    '<path d="M12 .5a12 12 0 0 0-3.79 23.4c.6.1.82-.26.82-.58v-2.2c-3.34.72-4.04-1.42-4.04-1.42-.55-1.4-1.34-1.77-1.34-1.77-1.1-.75.08-.73.08-.73 1.21.08 1.85 1.24 1.85 1.24 1.07 1.85 2.81 1.32 3.5 1 .1-.78.42-1.32.76-1.62-2.67-.3-5.47-1.34-5.47-5.96 0-1.32.47-2.4 1.24-3.24-.13-.3-.54-1.53.11-3.18 0 0 1.01-.32 3.3 1.24a11.5 11.5 0 0 1 6.01 0c2.29-1.56 3.3-1.24 3.3-1.24.65 1.65.24 2.88.12 3.18.77.84 1.23 1.92 1.23 3.24 0 4.63-2.8 5.65-5.48 5.95.43.37.82 1.1.82 2.22v3.29c0 .32.21.69.82.57A12 12 0 0 0 12 .5Z"/>',
  scholar:
    '<path d="M12 2 1 8.5l11 6.5 9-5.32V17h2V8.5L12 2Z"/><path d="M5 12.4v3.9c0 2.2 3.13 3.7 7 3.7s7-1.5 7-3.7v-3.9l-7 4.14-7-4.14Z"/>',
  linkedin:
    '<path d="M4.98 3.5a2.5 2.5 0 1 1 0 5 2.5 2.5 0 0 1 0-5ZM3 9h4v12H3V9Zm6.5 0h3.83v1.64h.06c.53-.96 1.83-1.98 3.77-1.98 4.03 0 4.78 2.5 4.78 5.76V21h-4v-5.7c0-1.36-.03-3.1-1.94-3.1-1.94 0-2.24 1.47-2.24 3v5.8h-4V9Z"/>',
  mail: '<path d="M2.5 5.5A2 2 0 0 1 4.5 4h15a2 2 0 0 1 2 1.5L12 12.4 2.5 5.5Z"/><path d="M22 7.8V18a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V7.8l9.42 6.85a1 1 0 0 0 1.16 0L22 7.8Z"/>',
  x: '<path d="M17.53 3h3.14l-6.86 7.84L22 21h-6.33l-4.95-6.47L4.96 21H1.82l7.34-8.39L1.5 3h6.49l4.48 5.92L17.53 3Zm-1.1 16.13h1.74L7.66 4.78H5.8l10.63 14.35Z"/>',
  arrow:
    '<path d="M7 17 17 7M9 7h8v8" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>',
  'arrow-down':
    '<path d="M12 4v16m0 0 6-6m-6 6-6-6" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>',
  sun: '<circle cx="12" cy="12" r="4.2"/><path d="M12 1.5v2.6M12 19.9v2.6M4.2 4.2l1.9 1.9M17.9 17.9l1.9 1.9M1.5 12h2.6M19.9 12h2.6M4.2 19.8l1.9-1.9M17.9 6.1l1.9-1.9" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/>',
  moon: '<path d="M21 13.2A9.2 9.2 0 1 1 10.8 3a7.4 7.4 0 0 0 10.2 10.2Z"/>',
  copy: '<rect x="9" y="9" width="12" height="12" rx="2.5" fill="none" stroke="currentColor" stroke-width="1.7"/><path d="M15 5.2A2.2 2.2 0 0 0 12.8 3H5.2A2.2 2.2 0 0 0 3 5.2v7.6A2.2 2.2 0 0 0 5.2 15" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/>',
};
---

<svg
  class={className}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="currentColor"
  aria-hidden="true"
  focusable="false"
  {...rest}
  set:html={paths[name]}
/>
