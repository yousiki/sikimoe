---
import Icon from './Icon.astro';
import { profile } from '../data/profile';

const year = new Date().getFullYear();
const buildDate = new Date().toISOString().slice(0, 10);
---

<footer class="border-line border-t">
  <div
    class="footer__inner container-page flex flex-col gap-6 py-10 sm:flex-row sm:items-center sm:justify-between"
  >
    {
      /* One expression: a line break between two of them collapses to nothing,
        which is what turned this into "© 2026Siqi Yang". */
    }
    <p class="text-faint font-mono text-xs tracking-wide">{`© ${year} ${profile.name}`}</p>

    <div class="text-faint flex flex-wrap items-center gap-x-5 gap-y-2 font-mono text-xs">
      <span>Built with Astro · Deployed on Cloudflare</span>
      <span class="hidden sm:inline" aria-hidden="true">·</span>
      <a
        href="https://github.com/yousiki/siki.moe"
        target="_blank"
        rel="noopener"
        class="link-underline hover:text-ink inline-flex items-center gap-1.5 transition-colors"
      >
        <Icon name="github" size={13} />
        Source
      </a>
      <span class="hidden sm:inline" aria-hidden="true">·</span>
      <time datetime={buildDate}>{buildDate}</time>
    </div>
  </div>
</footer>

<style>
  .footer__inner {
    padding-bottom: calc(2.5rem + env(safe-area-inset-bottom, 0px));
  }

  @media (pointer: coarse) {
    a {
      min-height: 2.75rem;
    }
  }
</style>
