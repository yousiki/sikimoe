---
import Icon from './Icon.astro';
import { profile } from '../data/profile';

const year = new Date().getFullYear();
const buildDate = new Date().toISOString().slice(0, 10);
---

<footer class="border-line border-t">
  <div
    class="container-page flex flex-col gap-6 py-10 sm:flex-row sm:items-center sm:justify-between"
  >
    <p class="text-faint font-mono text-xs tracking-wide">
      © {year}
      {profile.name} · {profile.nameLocal}
    </p>

    <div class="text-faint flex flex-wrap items-center gap-x-5 gap-y-2 font-mono text-xs">
      <span>Built with Astro · Deployed on Cloudflare</span>
      <span class="hidden sm:inline" aria-hidden="true">·</span>
      <a
        href="https://github.com/yousiki/siki.moe"
        target="_blank"
        rel="noopener"
        class="link-underline hover:text-ink inline-flex items-center gap-1.5 transition-colors"
      >
        <Icon name="github" size={13} />
        Source
      </a>
      <span class="hidden sm:inline" aria-hidden="true">·</span>
      <time datetime={buildDate}>{buildDate}</time>
    </div>
  </div>
</footer>
