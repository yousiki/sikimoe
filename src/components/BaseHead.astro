---
import '../styles/global.css';

/*
 * Every `@font-face` lives in a linked stylesheet, so left alone the browser
 * cannot discover a single font until that CSS has downloaded and parsed —
 * HTML, then CSS, then woff2, three round trips deep. Importing the files here
 * lets Vite hand back their hashed build URLs, which the preloads below hoist
 * into the first response.
 *
 * These three are what a cold load actually requests, measured rather than
 * assumed. Two faces are deliberately absent: the CJK subset and the italic
 * subset are both small enough that Vite inlines them into the stylesheet as
 * data URIs, so there is nothing left to fetch — preloading them would copy
 * their base64 into the HTML a second time (measured: +2.6 kB gzipped) to
 * prefetch a URL that never hits the network. The remaining nine faces in the
 * bundle are gated behind `unicode-range` for scripts this site never sets.
 */
import geistSans from '@fontsource-variable/geist/files/geist-latin-wght-normal.woff2?url';
import geistMono from '@fontsource-variable/geist-mono/files/geist-mono-latin-wght-normal.woff2?url';
import serifRoman from '@fontsource/instrument-serif/files/instrument-serif-latin-400-normal.woff2?url';

import { SITE_DESCRIPTION, SITE_LOCALE, SITE_OG_IMAGE, SITE_TITLE, SITE_URL } from '../data/site';
import { profile } from '../data/profile';

interface Props {
  title?: string | undefined;
  description?: string | undefined;
}

const { title = SITE_TITLE, description = SITE_DESCRIPTION } = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site ?? SITE_URL).href;
const ogImage = new URL(SITE_OG_IMAGE, Astro.site ?? SITE_URL).href;

const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: profile.name,
  alternateName: [profile.nameLocal, profile.alias],
  jobTitle: profile.role,
  email: `mailto:${profile.email}`,
  url: SITE_URL,
  image: ogImage,
  description: SITE_DESCRIPTION,
  affiliation: {
    '@type': 'CollegeOrUniversity',
    name: 'Peking University',
    url: 'https://english.pku.edu.cn/',
  },
  // Research areas, not the side interests in `profile.interests`.
  knowsAbout: profile.researchAreas,
  sameAs: profile.socials.filter((s) => s.icon !== 'mail').map((s) => s.href),
};
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
<meta name="generator" content={Astro.generator} />

{
  /* `crossorigin` is not optional here even though these are same-origin: fonts
     are always fetched in CORS mode, and a preload whose mode disagrees with the
     eventual request is discarded and downloaded a second time. */
  [geistSans, geistMono, serifRoman].map((href) => (
    <link rel="preload" as="font" type="font/woff2" href={href} crossorigin="anonymous" />
  ))
}

<title>{title}</title>
<meta name="description" content={description} />
<meta name="author" content={profile.name} />
<link rel="canonical" href={canonical} />

<meta property="og:type" content="profile" />
<meta property="og:site_name" content={profile.name} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogImage} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:locale" content="en_US" />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />
<meta name="twitter:creator" content="@__yousiki__" />

<meta name="theme-color" content="#08080a" />
<meta name="color-scheme" content="dark light" />

<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
<link rel="alternate icon" href="/favicon.ico" sizes="32x32" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
<link rel="manifest" href="/site.webmanifest" />
<link rel="sitemap" href="/sitemap-index.xml" />

<meta http-equiv="content-language" content={SITE_LOCALE} />

<script type="application/ld+json" set:html={JSON.stringify(personSchema)} is:inline />

{/* Resolve the theme before first paint so there is never a flash of the wrong palette. */}
<script is:inline>
  (() => {
    try {
      const stored = localStorage.getItem('siki-theme');
      const theme =
        stored === 'light' || stored === 'dark'
          ? stored
          : window.matchMedia('(prefers-color-scheme: light)').matches
            ? 'light'
            : 'dark';
      document.documentElement.dataset.theme = theme;
    } catch {
      document.documentElement.dataset.theme = 'dark';
    }
  })();
</script>

{/* Without JS nothing should stay invisible waiting for an observer that never runs. */}
<noscript>
  <style>
    [data-reveal] {
      opacity: 1 !important;
      transform: none !important;
      filter: none !important;
    }
    .char {
      opacity: 1 !important;
      transform: none !important;
    }
    [data-disclosure-panel] .pub--extra {
      grid-template-rows: minmax(0, 1fr) !important;
      border-bottom-width: 1px !important;
      opacity: 1 !important;
      visibility: visible !important;
    }
  </style>
</noscript>
