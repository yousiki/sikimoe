---
/**
 * Splits a string into per-character spans at build time so the staggered
 * entrance costs no layout shift and degrades to plain text without JS.
 */
interface Props {
  text: string;
  /** Milliseconds added before this block's first character animates. */
  baseDelay?: number;
}

const { text, baseDelay = 0 } = Astro.props;
const characters = [...text];
---

<span style={`--char-base:${baseDelay}ms`} aria-label={text}>
  {
    characters.map((char, index) =>
      char === ' ' ? (
        <span class="char char--space" style={`--char-index:${index}`} aria-hidden="true" />
      ) : (
        <span class="char" style={`--char-index:${index}`} aria-hidden="true">
          {char}
        </span>
      ),
    )
  }
</span>
