---
import SectionHeading from '../SectionHeading.astro';
import { profile } from '../../data/profile';
---

<section id="recognition" class="container-page scroll-mt-24 py-24 md:py-36">
  <SectionHeading index="05 — Recognition" title="Medals, mostly from problems." />

  <div class="grid gap-14 lg:grid-cols-12 lg:gap-16">
    <ul class="border-line border-t lg:col-span-7">
      {
        profile.awards.map((award) => (
          <li
            class="award border-line flex items-baseline gap-6 border-b py-4"
            data-reveal
            data-reveal-group="awards"
          >
            <span class="text-faint w-20 shrink-0 font-mono text-xs tracking-[0.12em] tabular-nums">
              {award.year}
            </span>
            <span class="min-w-0 flex-1">
              <span class="block text-base leading-snug sm:text-lg">{award.title}</span>
              {award.detail && (
                <span class="text-accent mt-1 block font-mono text-[0.7rem] tracking-[0.14em] uppercase">
                  {award.detail}
                </span>
              )}
            </span>
          </li>
        ))
      }
    </ul>

    <div class="lg:col-span-4 lg:col-start-9">
      <h3 class="eyebrow" data-reveal>Academic Service</h3>
      <div class="mt-6 space-y-8">
        {
          profile.service.map((group) => (
            <div data-reveal data-reveal-group="service">
              <p class="text-muted text-sm">{group.label}</p>
              <ul class="mt-3 flex flex-wrap gap-2">
                {group.items.map((item) => (
                  <li class="border-line text-muted rounded-full border px-3 py-1 font-mono text-[0.7rem] tracking-[0.1em]">
                    {item}
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>

<style>
  .award {
    transition: padding-left 0.4s var(--ease-out-expo);
  }

  .award:hover {
    padding-left: 0.5rem;
  }
</style>
