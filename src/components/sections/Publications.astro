---
import Icon from '../Icon.astro';
import PublicationRow from '../PublicationRow.astro';
import SectionHeading from '../SectionHeading.astro';
import { profile, publicationsByYear } from '../../data/profile';

const scholar = profile.socials.find((s) => s.icon === 'scholar');
---

<section id="publications" class="container-page scroll-mt-24 py-24 md:py-36">
  <SectionHeading
    index="04 — Publications"
    title="Selected publications."
    lead={`${publicationsByYear.length} papers across CVPR, ICCV, ECCV, NeurIPS, SIGGRAPH Asia and TPAMI.`}
  />

  {
    /* One list, newest first, whether or not it is expanded: the unselected rows
      are collapsed where they belong in the order rather than appended after it,
      so pressing the toggle never restarts the years from the top. */
  }
  <ul id="all-publications" class="border-line border-t" data-disclosure-panel>
    {
      publicationsByYear.map((publication) => (
        <PublicationRow
          publication={publication}
          extra={!publication.selected}
          group={publication.selected ? 'pubs' : undefined}
        />
      ))
    }
  </ul>

  <div class="mt-10 flex flex-wrap items-center gap-4" data-reveal>
    <button
      type="button"
      data-disclosure-toggle
      data-label-closed={`Show all ${publicationsByYear.length}`}
      data-label-open="Show fewer"
      aria-expanded="false"
      aria-controls="all-publications"
      class="border-line hover:border-ink group inline-flex items-center gap-2.5 rounded-full border px-5 py-2.5 font-mono text-xs tracking-[0.14em] uppercase transition-colors duration-300"
    >
      <span data-disclosure-label>Show all {publicationsByYear.length}</span>
      <span
        class="bg-faint size-1 rounded-full transition-colors group-hover:bg-[var(--accent)]"
        aria-hidden="true"></span>
    </button>

    {
      scholar && (
        <a
          href={scholar.href}
          target="_blank"
          rel="noopener"
          class="text-muted hover:text-ink inline-flex items-center gap-2 font-mono text-xs tracking-[0.14em] uppercase transition-colors"
        >
          <span class="link-underline">Google Scholar</span>
          <Icon name="arrow" size={13} />
        </a>
      )
    }
  </div>
</section>
