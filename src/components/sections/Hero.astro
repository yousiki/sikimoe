---
import Icon from '../Icon.astro';
import SplitText from '../SplitText.astro';
import { profile } from '../../data/profile';
---

<section id="top" class="relative isolate flex min-h-[100svh] flex-col overflow-hidden" data-hero>
  {/* Simulated spike-camera sensor. Purely decorative. */}
  <canvas
    data-spike-field
    class="spike-canvas pointer-events-auto absolute inset-0 -z-10 h-full w-full"
    aria-hidden="true"></canvas>

  <div
    class="pointer-events-none absolute inset-0 -z-10 bg-[radial-gradient(115%_70%_at_45%_10%,transparent_30%,var(--paper)_95%)]"
    aria-hidden="true"
  >
  </div>

  {/* Vertical index rule — fills the right margin the way a print grid would. */}
  <div
    class="text-faint pointer-events-none absolute inset-y-0 right-8 hidden flex-col items-center justify-center gap-6 lg:flex xl:right-12"
    aria-hidden="true"
  >
    <span class="bg-line h-16 w-px"></span>
    <span class="font-mono text-[0.65rem] tracking-[0.42em] uppercase [writing-mode:vertical-rl]">
      Computational Photography
    </span>
    <span class="bg-line h-16 w-px"></span>
  </div>

  <div class="container-page flex flex-1 flex-col justify-between pt-28 pb-10 md:pt-32 md:pb-14">
    {/* ── status strip ─────────────────────────────────────────────── */}
    <div
      class="text-faint flex flex-wrap items-center gap-x-6 gap-y-2 font-mono text-[0.7rem] tracking-[0.16em] uppercase"
    >
      <span class="flex items-center gap-2">
        <span class="relative flex size-1.5">
          <span
            class="bg-accent-2 absolute inline-flex size-full rounded-full opacity-75"
            style="animation: pulse-ring 2.4s var(--ease-out-quint) infinite"></span>
          <span class="bg-accent-2 relative inline-flex size-1.5 rounded-full"></span>
        </span>
        {profile.location}
      </span>
      <span class="flex items-center gap-2">
        <span class="text-faint/70">Local</span>
        <span class="text-muted tabular-nums" data-clock={profile.timezone}>--:--:--</span>
      </span>
    </div>

    {/* ── name block ───────────────────────────────────────────────── */}
    <div class="flex flex-col gap-6 py-12 md:py-16">
      <p class="text-muted font-mono text-sm tracking-[0.3em] sm:text-base">
        <SplitText text={profile.nameLocal} baseDelay={120} />
      </p>

      <h1 class="font-display text-[clamp(3.4rem,15vw,11.5rem)] leading-[0.82] tracking-[-0.03em]">
        <span class="block"><SplitText text="Siqi" baseDelay={220} /></span>
        <span class="block pl-[0.08em] italic"><SplitText text="Yang" baseDelay={380} /></span>
      </h1>

      <div class="mt-2" data-reveal style="--reveal-delay:560ms">
        <p class="text-muted max-w-md text-base leading-relaxed sm:text-lg">
          {profile.role} at the{' '}
          <a
            href={profile.affiliationHref}
            target="_blank"
            rel="noopener"
            class="link-underline text-ink">Camera Intelligence Lab</a
          >, Peking University. I work on{' '}
          <span class="rotator" data-rotator>
            {
              profile.rotatingWords.map((word) => (
                <span class="rotator__item text-gradient font-medium" data-rotator-item>
                  {word}.
                </span>
              ))
            }
            {
              /* Reserves the widest word so the sentence never reflows mid-cycle.
                The full stop travels with each word, so the slack it leaves over
                is trailing whitespace at the end of a line. */
            }
            <span class="rotator__sizer" aria-hidden="true">
              {`${profile.rotatingWords.reduce((a, b) => (a.length > b.length ? a : b))}.`}
            </span>
          </span>
        </p>
      </div>
    </div>

    {/* ── footer of the hero ───────────────────────────────────────── */}
    <div
      class="flex flex-col gap-6 sm:flex-row sm:items-end sm:justify-between"
      data-reveal
      style="--reveal-delay:720ms"
    >
      <ul class="flex flex-wrap items-center gap-x-5 gap-y-3">
        {
          profile.socials.map((social) => (
            <li>
              <a
                href={social.href}
                target={social.icon === 'mail' ? undefined : '_blank'}
                rel="noopener"
                class="text-muted hover:text-ink group inline-flex items-center gap-2 font-mono text-xs tracking-wider uppercase transition-colors duration-300"
              >
                <Icon name={social.icon} size={14} />
                <span class="link-underline">{social.label}</span>
              </a>
            </li>
          ))
        }
      </ul>

      <a
        href="#about"
        class="text-faint hover:text-ink group inline-flex items-center gap-3 self-start font-mono text-[0.7rem] tracking-[0.2em] uppercase transition-colors sm:self-auto"
      >
        Scroll
        <span
          class="border-line grid size-9 place-items-center rounded-full border transition-transform duration-500 group-hover:translate-y-1"
        >
          <Icon name="arrow-down" size={14} />
        </span>
      </a>
    </div>
  </div>
</section>

<style>
  /* Keep the sensor readout away from the header and the name, so it reads as
     atmosphere rather than as noise laid over the type. */
  .spike-canvas {
    mask-image: radial-gradient(105% 78% at 62% 52%, black 12%, transparent 78%);
    opacity: 0.95;
  }

  :global([data-theme='light']) .spike-canvas {
    /* Dark dots on paper carry far more visual weight than light dots on ink. */
    opacity: 0.55;
  }

  /* The rotator reserves the width of its longest word so the sentence around
     it never reflows as the words cycle. */
  .rotator {
    position: relative;
    display: inline-grid;
    vertical-align: bottom;
  }

  .rotator__sizer {
    visibility: hidden;
    pointer-events: none;
    grid-area: 1 / 1;
    white-space: nowrap;
  }

  .rotator__item {
    grid-area: 1 / 1;
    white-space: nowrap;
    opacity: 0;
    transform: translate3d(0, 0.55em, 0);
    transition:
      opacity 0.55s var(--ease-out-expo),
      transform 0.55s var(--ease-out-expo);
  }

  .rotator__item[data-current] {
    opacity: 1;
    transform: none;
  }

  .rotator__item[data-leaving] {
    opacity: 0;
    transform: translate3d(0, -0.55em, 0);
  }

  @media (prefers-reduced-motion: reduce) {
    .rotator__item[data-current] {
      opacity: 1;
      transform: none;
    }
  }
</style>
