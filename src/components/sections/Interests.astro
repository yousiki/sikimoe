---
import SectionHeading from '../SectionHeading.astro';
import { profile } from '../../data/profile';
---

<section id="interests" class="container-page scroll-mt-24 py-24 md:py-36">
  <SectionHeading
    index="02 — Interests"
    title="Where the spare cycles go."
    lead="What the evenings are for, and what keeps me honest about how much of this technology actually works in someone's hands."
  />

  <div class="grid gap-5 md:grid-cols-3">
    {
      profile.interests.map((interest) => (
        <article
          class="focus-card"
          data-tilt="4"
          data-reveal
          data-reveal-group="interests"
          data-cursor-target
        >
          <div class="focus-card__spot" aria-hidden="true" />
          <div class="relative flex h-full flex-col">
            <span class="eyebrow tabular-nums">{interest.index}</span>
            <h3 class="font-display mt-6 text-2xl leading-tight sm:text-3xl">{interest.title}</h3>
            <p class="text-muted mt-4 text-sm leading-relaxed sm:text-base">{interest.blurb}</p>
            <div class="mt-auto pt-8" aria-hidden="true">
              <span class="focus-card__rule" />
            </div>
          </div>
        </article>
      ))
    }
  </div>
</section>

<style>
  .focus-card {
    position: relative;
    overflow: hidden;
    border-radius: 1.25rem;
    border: 1px solid var(--line);
    background-color: color-mix(in oklab, var(--raised) 60%, transparent);
    padding: 1.75rem;
    transition:
      transform 0.4s var(--ease-out-expo),
      border-color 0.4s ease,
      background-color 0.4s ease;
    transform-style: preserve-3d;
  }

  @media (width >= 640px) {
    .focus-card {
      padding: 2rem;
      min-height: 20rem;
    }
  }

  .focus-card:hover {
    border-color: var(--line-strong);
    background-color: color-mix(in oklab, var(--raised) 95%, transparent);
  }

  .focus-card__spot {
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity 0.45s ease;
    background: radial-gradient(
      22rem circle at var(--spot-x, 50%) var(--spot-y, 0%),
      var(--glow),
      transparent 65%
    );
  }

  .focus-card:hover .focus-card__spot {
    opacity: 1;
  }

  .focus-card__rule {
    display: block;
    height: 1px;
    background: linear-gradient(to right, var(--accent), transparent);
    width: 2.5rem;
    transition: width 0.6s var(--ease-out-expo);
  }

  .focus-card:hover .focus-card__rule {
    width: 100%;
  }
</style>
